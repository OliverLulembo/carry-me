# Local SQLite — Prisma. Swap to Postgres later by changing the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Vercel / production: use a hosted Postgres URL (Vercel Postgres, Neon, etc.).
# SQLite file: URLs do not work on serverless — set DATABASE_URL in the Vercel project env.
# After switching schema to postgresql, run migrations against that database before deploy.

# JWT signing secret for API auth (used by mobile + web).
# Generate a real one for any non-dev use: `openssl rand -base64 48`
JWT_SECRET="dev-only-change-me-please-change-me-please-change-me"

# Comma-separated list of allowed origins for the JSON API (CORS).
# Leave * in local dev so the RN app on a device/emulator can hit the laptop.
ALLOWED_ORIGINS="*"

# Demo passenger seeded into the DB. Used by /api/auth/dev-login.
DEMO_PASSENGER_PHONE="+260977000001"
