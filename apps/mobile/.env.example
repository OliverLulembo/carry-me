# Base URL for the CarryMe JSON API (the Next.js app under apps/web).
# Use your laptop's LAN IP when running on a physical device.
# Defaults / fallbacks:
#   - Android emulator: http://10.0.2.2:3000
#   - iOS simulator:    http://localhost:3000
#   - Physical phone:   http://<laptop-LAN-ip>:3000  (e.g. http://192.168.1.42:3000)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
